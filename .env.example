# ==============================================================================
# Environment Configuration
# ==============================================================================

# IMPORTANT SECURITY NOTE:
# Do NOT use this default secret in production! Generate your own secure 256-bit
# secret key by running:
#   openssl rand -hex 32
# or in Python:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Redis connection URL
# Use redis://127.0.0.1:6379/0 for local runner or redis://redis:6379/0 inside Docker Compose
REDIS_URL=redis://127.0.0.1:6379/0

# Sliding-Window Rate Limiter settings
# Default: 10 requests allowed per 60 seconds per unique client identity (JWT user ID or API key)
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# Fail mode when Redis is unreachable / degraded:
# - closed : Return 503 Service Unavailable to protect downstream services from abuse
# - open   : Allow traffic through to prioritize service availability over rate limiting
RATE_LIMIT_FAIL_MODE=closed

# Upstream services
# Local: http://127.0.0.1:8001 | Docker Compose: http://example_service:8001
EXAMPLE_UPSTREAM=http://127.0.0.1:8001

# Gateway settings
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
LOG_LEVEL=INFO
