# JWT
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Redis
REDIS_URL=redis://redis:6379/0

# Sliding-window rate limiter
# 10 requests per 60 seconds per identity (JWT user id or X-API-Key)
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60
# closed = reject with 503 if Redis is down (protect backends)
# open   = allow traffic if Redis is down (prefer availability)
RATE_LIMIT_FAIL_MODE=closed

# Upstream mock services (Compose service DNS names)
ORDERS_UPSTREAM=http://service_orders:8001
INVENTORY_UPSTREAM=http://service_inventory:8002
USERS_UPSTREAM=http://service_users:8003

# Gateway
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
LOG_LEVEL=INFO
